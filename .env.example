# ─────────────────────────────────────────────
# Voting Secure — local development environment
# ─────────────────────────────────────────────

NODE_ENV=
PORT=

# ─── PostgreSQL ───────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# ─── MongoDB (audit chain) ────────────────────
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=
MONGO_APP_PASSWORD=
MONGO_URI=

# ─── Redis ────────────────────────────────────
REDIS_HOST=
REDIS_PORT=

# ─── Auth / Cookies / JWT ─────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=

# ─── Mail (Mailpit for local dev) ─────────────
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
FRONTEND_URL=

# ─── Crypto secrets ───────────────────────────
ENCRYPTION_KEYS=
BLIND_INDEX_KEY=
TOKEN_HASH_SECRET=
BALLOT_SECRET=

# ─── Audit chain / signing ────────────────────
GENESIS_SEED=
VOTING_RSA_KEY_SIZE=2048
